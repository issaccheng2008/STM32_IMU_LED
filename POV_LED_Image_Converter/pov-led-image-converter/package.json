{
  "name": "pov-led-image-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Offline image sampler and WAND1 SK9822 exporter for a hand-waved POV wand",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node tests/test-core.js && npm run test:firmware",
